<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CycleTrack" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
    <style name="Theme.CycleTrack.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D1B2A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">#0D1B2A</item>
        <item name="postSplashScreenTheme">@style/Theme.CycleTrack</item>
    </style>
</resources>
